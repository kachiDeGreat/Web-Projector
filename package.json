{
  "name": "web-projector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "vite build && electron electron/main.cjs",
    "build:exe": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux",
    "build:all": "vite build && electron-builder -wl"
  },
  "build": {
    "appId": "com.webprojector.app",
    "productName": "Web Projector",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "BIBLE",
        "to": "BIBLE"
      },
      {
        "from": "songs",
        "to": "songs"
      },
      {
        "from": "public/backgrounds",
        "to": "public/backgrounds"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/formidable": "^3.5.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "formidable": "^3.5.4",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-qrcode": "^0.4.1"
  }
}
