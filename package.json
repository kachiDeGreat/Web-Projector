{
  "name": "web-projector",
  "private": true,
  "version": "1.0.0",
  "description": "Professional Church & Stage Projection Software for Lyrics, Bible Scriptures, and Media",
  "author": "Web Projector Team <support@webprojector.app>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs --no-sandbox",
    "electron:dev": "vite build && electron electron/main.cjs --no-sandbox",
    "build:exe": "npm run build && electron-builder --win nsis portable",
    "build:win": "npm run build && electron-builder --win nsis portable",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:mac": "npm run build && electron-builder --mac zip",
    "build:all": "npm run build && electron-builder -wl",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.webprojector.app",
    "productName": "Web Projector",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "public/**/*",
      "node_modules/formidable/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "BIBLE",
        "to": "BIBLE"
      },
      {
        "from": "songs",
        "to": "songs"
      },
      {
        "from": "public/backgrounds",
        "to": "public/backgrounds"
      },
      {
        "from": "super_settings.json",
        "to": "super_settings.json"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "formidable": "^3.5.4",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/formidable": "^3.5.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-qrcode": "^0.4.1"
  }
}
